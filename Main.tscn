[sub_resource type="GDScript" id="GDScript_0dkek"]
resource_name = "player.gd"
script/source = "extends CharacterBody2D

@export var death_screen: CanvasLayer
@export var animated_sprite: AnimatedSprite2D

const SPEED = 300.0
const JUMP_VELOCITY = -600.0

var is_attacking: bool = false


func _ready() -> void:
	if animated_sprite:
		animated_sprite.animation_finished.connect(_on_player_animation_finished)


func _input(event: InputEvent) -> void:
	# animation
	if event.is_action_pressed(\"attack\") and not is_attacking:
		if animated_sprite:
			is_attacking = true
			animated_sprite.play(\"slice\")
			animated_sprite.frame = 0


func _physics_process(delta: float) -> void:
	
	if not is_on_floor():
		velocity += get_gravity() * delta

	# jump.
	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY
		
	var direction := Input.get_axis(\"ui_left\", \"ui_right\")
	if direction != 0:
		velocity.x = direction * SPEED
		if animated_sprite:
			animated_sprite.flip_h = (direction < 0)
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	if not is_attacking and animated_sprite:
		if direction != 0:
			animated_sprite.play(\"walk\")
		else:
			animated_sprite.play(\"idle\")

	move_and_slide()


func _on_animation_finished() -> void:
	print(\"Animation finished!\")
	if animated_sprite and animated_sprite.animation == \"slice\":
		is_attacking = false


func _on_area_2d_body_entered(body: Node2D) -> void:
	if death_screen:
		death_screen.visible = true
	get_tree().paused = true


func _on_player_animation_finished() -> void:
	print(\"Animation finished!\")
	if animated_sprite and animated_sprite.animation == \"slice\":
		is_attacking = false
"

